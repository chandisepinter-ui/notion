# ---------------------------------------------------------------
# Titan SOC Academy - environment settings
# `npm run setup` copies this file to .env and fills SESSION_SECRET.
# Never commit .env. Never put real credentials in this example file.
# ---------------------------------------------------------------

# Local SQLite database file (development). Production will use PostgreSQL.
DATABASE_URL=file:./data/titan-academy.db

# Long random string used to sign login sessions. Generated by setup.
SESSION_SECRET=

# AUTH_MODE controls how people sign in.
#   demo        = one-click demonstration accounts. NOT SECURE. Local testing only.
#   production  = demo sign-in disabled. (Microsoft Entra ID sign-in is planned; not yet built.)
AUTH_MODE=demo
