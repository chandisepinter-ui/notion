{
  "name": "titan-soc-academy",
  "version": "0.1.0",
  "private": true,
  "description": "Titan SOC Academy - security operations training platform (Phase 1 foundation)",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "node scripts/reset.mjs",
    "content:import": "tsx scripts/import-powerapps.ts",
    "media:import": "node scripts/import-immix-media.mjs",
    "media:walkthroughs": "node scripts/import-walkthroughs.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "test:content": "node tests/e2e/run-e2e.mjs content",
    "check": "npm run typecheck && npm run test"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.15",
    "lucide-react": "^1.68.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "jimp": "^1.6.1",
    "playwright": "^1.63.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
